---
// ============================================================================
// Classic Layout - classic/index.astro
// ============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Section from '../../components/Section.astro';
import { siteConfig } from '../../data/site';
import { generateCV } from '../../data/merge';
import { resolveCVVersion } from '../../data/version';
import { CV_VERSIONS, type CVVersion } from '../../types/cv';

export interface Props {
  version?: CVVersion;
}

const { version = resolveCVVersion() } = Astro.props;
const cvData = generateCV(version);

const pageTitle = `${siteConfig.title} • ${CV_VERSIONS[version].label} • Clásico`;
const pageDescription = siteConfig.description;
---

<BaseLayout title={pageTitle} description={pageDescription} layoutClass="layout-classic">
  <article class="cv layout-classic">
    <Header site={siteConfig} layout="classic" />

    {cvData.sections.map(section => (
      <Section section={section} variant="classic" />
    ))}
  </article>
</BaseLayout>